// ~/.config/waybar/config.jsonc
// Waybar >= 0.10 — Hyprland, barre en haut, identique sur les 2 écrans
{
  // ——— Configuration globale ———
  "layer": "top",
  "position": "top",
  "height": 24,
  "margin-top": 6,
  "margin-left": 6,
  "margin-right": 6,
  "margin-bottom": 0,
  "reload_style_on_change": true,

  // ——— Listes de modules ———
  "modules-left": ["group/left"],
  "modules-center": ["group/center"],
  "modules-right": ["group/right"],

  // ————————————————————— GAUCHE —————————————————————
  "group/left": {
    "orientation": "inherit",
    "modules": ["group/l1", "custom/sep", "group/l2"]
  },

  "group/l1": {
    "orientation": "inherit",
    "modules": ["hyprland/workspaces"]
  },

  "group/l2": {
    "orientation": "inherit",
    "modules": ["hyprland/window"]
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Librewolf": "  $1",
      "(.*) — Kate": "󱃖  $1",
      "([~/…].*)": "󰆍  $1",
      "nvim (.*)": "  $1",
    }
  },

  // ————————————————————— CENTRE —————————————————————
  "group/center": {
    "orientation": "inherit",
    "modules": ["group/c1", "custom/sep", "group/c2"]
  },

  "group/c1": {
    "orientation": "inherit",
    "modules": ["clock"]
  },

  "group/c2": {
    "orientation": "inherit",
    "modules": ["custom/mediaplayer"]
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}",
    "actions": {
      "onclick": "zoom",
      "on-scroll-up": "shift prev_month",
      "on-scroll-down": "shift next_month",
      "tooltip-scroll": "shift next_month"
    },
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#a6adc8'><tt><b>{}</b></tt></span>",
        "days": "<span color='#bac2de'>{}</span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today": "<u><span color='#f5c2e7'><b>{}</b></span></u>",
        "weekly": "<span color='#94e2d0'>W{}</span>",
        "max_length": 25
      }
    }
  },

  "custom/mediaplayer": {
    "exec": "~/.config/waybar/scripts/mediaplayer.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-scroll-up": "playerctl position 5+",
    "on-scroll-down": "playerctl position 5-",
    "format": "{}",
    "max-length": 60
  },

  // ————————————————————— DROITE —————————————————————
  "group/right": {
    "orientation": "inherit",
    "modules": [
      "group/r1",
      "custom/sep",
      "group/r2",
      "custom/sep",
      "group/power-menu"
    ]
  },

  // Sous-groupe 1 : icônes seules, infos textuelles en tooltip
  "group/r1": {
    "orientation": "inherit",
    "modules": [
      "custom/privacy",
      "custom/swaync",
      "network",
      "bluetooth",
      "pulseaudio"
    ]
  },

  // Sous-groupe 2 : icône + valeur texte (système)
  "group/r2": {
    "orientation": "inherit",
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "battery"
    ]
  },

  // Power-menu : drawer au survol, s'ouvre de droite à gauche
  "group/power-menu": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": false,
      "click-to-reveal": false
    },
    "modules": [
      "custom/power-shutdown",
      "custom/power-lock",
      "custom/power-suspend",
      "custom/power-logout",
      "custom/power-reboot",
    ]
  },

  // ——— Séparateur ———
  "custom/sep": {
    "exec": "~/.config/waybar/scripts/sep.sh",
    "return-type": "json",
    "interval": "once"
  },

  "custom/privacy": {
    "exec": "~/.config/waybar/scripts/privacy.sh",
    "return-type": "json",
    "interval": 2
  },

  "custom/swaync": {
    "exec": "~/.config/waybar/scripts/swaync.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/swaync-toggle.sh",
    "tooltip": true
  },

  "network": {
    "interface": "wlp*",
    "family": "ipv4",
    "format-wifi": "",
    "format-disconnected": "⚠",
    "tooltip-format-wifi": "{essid}\nIP : {ipaddr}/{cidr}\nSignal : {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}\nIP : {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Déconnecté",
    "on-click": "~/.config/waybar/scripts/network-menu.sh",
    "interval": 10
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-off": "",
    "format-connected": "",
    "tooltip": true,
    "tooltip-format": "{status}\n{num_connections} appareil(s)",
    "controller": "org/bluez/hci0",
    "interval": 30
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "tooltip-format": "{volume}% {format_source}",
    "tooltip-format-muted": "Muet",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "~/.config/waybar/scripts/toggle-mute.sh",
    "on-click-right": "pavucontrol",
    "min-length": 2
  },

  // ——— Système ———
  "cpu": {
    "format": "  {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%\nCharge: {load}",
    "interval": 5
  },

  "memory": {
    "format": "  {percentage}%",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}Go / {total:0.1f}Go",
    "interval": 5
  },

  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon7/temp1_input",
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "tooltip": true,
    "tooltip-format": "{temperatureC}°C ({temperatureF}°F)",
    "interval": 5
  },

  "battery": {
    "adapter": "ACAD",
    "full-at": 100,
    "states": {"good": 95, "warning": 30, "critical": 15},
    "format": "{icon}  {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip": true,
    "interval": 60
  },

  // ——— Power-menu ———
  "custom/power-shutdown": {
    "format": "",
    "on-click": "systemctl poweroff",
    "tooltip": true,
    "tooltip-format": "Éteindre"
  },

  "custom/power-reboot": {
    "format": "",
    "on-click": "systemctl reboot",
    "tooltip": true,
    "tooltip-format": "Redémarrer"
  },

  "custom/power-logout": {
    "format": "",
    "on-click": "loginctl terminate-user $USER",
    "tooltip": true,
    "tooltip-format": "Déconnexion"
  },

  "custom/power-suspend": {
    "format": "",
    "on-click": "systemctl suspend",
    "tooltip": true,
    "tooltip-format": "Suspendre"
  },

  "custom/power-lock": {
    "format": "",
    "on-click": "echo 'Lock non configuré'",
    "tooltip": true,
    "tooltip-format": "Verrouiller (non configuré)"
  }
}
